{
  "$schema": "https://design-tokens.github.io/community-group/format/draft-v1.json",
  "name": "BCB Design Tokens",
  "version": "1.2.0",
  "description": "Design Tokens oficiais do Banco Central do Brasil para consumo programático por IA, Figma Tokens e sistemas de build.",
  "color": {
    "base": {
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Fundo base padrão (modo claro)"
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Preto puro absoluto"
      },
      "bodyText": {
        "$value": "#606060",
        "$type": "color",
        "$description": "Cor de texto padrão do corpo de página (extraído de produção)"
      },
      "bgLight": {
        "$value": "#E0EBEE",
        "$type": "color",
        "$description": "Fundo suave alternativo (.bg-color-12)"
      }
    },
    "brand": {
      "blue": {
        "$value": "#025C75",
        "$type": "color",
        "$description": "Azul institucional primário oficial (Pantone 3025)"
      },
      "blueDark": {
        "$value": "#013F50",
        "$type": "color",
        "$description": "Azul institucional escuro / Hover primário"
      },
      "gray80": {
        "$value": "#606062",
        "$type": "color",
        "$description": "Cinza institucional 80% (Pantone Cool Gray 10)"
      },
      "vinho": {
        "$value": "#2E4C59",
        "$type": "color",
        "$description": "Vinho / Azul ardósia institucional complementar"
      },
      "marsala": {
        "$value": "#736063",
        "$type": "color",
        "$description": "Marsala institucional complementar (usado em alertas de erro/críticos)"
      },
      "azulpetro": {
        "$value": "#077391",
        "$type": "color",
        "$description": "Azul petróleo complementar"
      },
      "azulnetuno": {
        "$value": "#476F82",
        "$type": "color",
        "$description": "Azul netuno complementar"
      },
      "azulcinti": {
        "$value": "#088694",
        "$type": "color",
        "$description": "Azul cinti complementar / Botão secundário"
      },
      "verdeSusta": {
        "$value": "#067078",
        "$type": "color",
        "$description": "Verde sustentabilidade complementar"
      },
      "verdeCastell": {
        "$value": "#DEBE7F",
        "$type": "color",
        "$description": "Verde castell complementar"
      },
      "amarellato": {
        "$value": "#F8D48D",
        "$type": "color",
        "$description": "Amarellato complementar (usado em destaque e títulos de hero)"
      },
      "cafellato": {
        "$value": "#47373A",
        "$type": "color",
        "$description": "Cafellato institucional complementar"
      }
    },
    "interaction": {
      "btnPrimaryBg": {
        "$value": "#025C75",
        "$type": "color",
        "$description": "Fundo padrão do botão primário"
      },
      "btnPrimaryHover": {
        "$value": "#013F50",
        "$type": "color",
        "$description": "Fundo do botão primário em hover"
      },
      "btnPrimaryActive": {
        "$value": "#012F3C",
        "$type": "color",
        "$description": "Fundo do botão primário em active/focus"
      },
      "btnSecondaryBg": {
        "$value": "#088694",
        "$type": "color",
        "$description": "Fundo padrão do botão secundário"
      },
      "btnSecondaryHover": {
        "$value": "#066974",
        "$type": "color",
        "$description": "Fundo do botão secundário em hover"
      },
      "btnSecondaryActive": {
        "$value": "#055861",
        "$type": "color",
        "$description": "Fundo do botão secundário em active/focus"
      },
      "linkColor": {
        "$value": "#1B75A6",
        "$type": "color",
        "$description": "Cor padrão de links e âncoras"
      },
      "linkHover": {
        "$value": "#013F50",
        "$type": "color",
        "$description": "Cor de links em hover"
      }
    },
    "gray": {
      "50": { "$value": "#FAFBFC", "$type": "color", "$description": "Cinza UI 50 - Fundo de áreas secundárias" },
      "100": { "$value": "#F3F5F7", "$type": "color", "$description": "Cinza UI 100 - Fundo de cards e caixas de busca" },
      "200": { "$value": "#E6EAEF", "$type": "color", "$description": "Cinza UI 200 - Bordas sutis e divisores" },
      "300": { "$value": "#D0D7DF", "$type": "color", "$description": "Cinza UI 300 - Bordas padrão de inputs e tabelas" },
      "400": { "$value": "#B7C0CB", "$type": "color", "$description": "Cinza UI 400 - Bordas em destaque e desabilitados" },
      "500": { "$value": "#9AA6B2", "$type": "color", "$description": "Cinza UI 500 - Textos de apoio e ícones secundários" },
      "600": { "$value": "#7E8A95", "$type": "color", "$description": "Cinza UI 600 - Textos muted e legendas" },
      "700": { "$value": "#606062", "$type": "color", "$description": "Cinza UI 700 - Texto escuro institucional" },
      "800": { "$value": "#3E454B", "$type": "color", "$description": "Cinza UI 800 - Títulos secundários" },
      "900": { "$value": "#22272B", "$type": "color", "$description": "Cinza UI 900 - Títulos principais e elementos escuros" },
      "1000": { "$value": "#0B0D0E", "$type": "color", "$description": "Cinza UI 1000 - Preto profundo de interface" }
    },
    "tint": {
      "brandLight": { "$value": "#F0F7F9", "$type": "color", "$description": "Tint suave para callout brand" },
      "verdeLight": { "$value": "#F0F8F8", "$type": "color", "$description": "Tint suave para callout success" },
      "amarellatoLight": { "$value": "#FEFBFA", "$type": "color", "$description": "Tint suave para callout warning" },
      "vinhoLight": { "$value": "#F5F7F8", "$type": "color", "$description": "Tint suave para callout danger" },
      "grayLight": { "$value": "#F8F9FB", "$type": "color", "$description": "Tint suave para callout neutral" }
    },
    "feedback": {
      "success": { "$value": "#28A745", "$type": "color", "$description": "Verde semântico de sucesso" },
      "warning": { "$value": "#D6A13B", "$type": "color", "$description": "Âmbar semântico de aviso/atenção" },
      "danger": { "$value": "#DC3545", "$type": "color", "$description": "Vermelho semântico de erro" },
      "info": { "$value": "#025C75", "$type": "color", "$description": "Azul semântico informativo" }
    },
    "highContrast": {
      "bgLevel1": { "$value": "#000000", "$type": "color", "$description": "Fundo absoluto em alto contraste" },
      "bgLevel2": { "$value": "#222222", "$type": "color", "$description": "Fundo de cartões em alto contraste" },
      "bgLevel3": { "$value": "#333333", "$type": "color", "$description": "Fundo de botões e controles" },
      "text": { "$value": "#FFFFFF", "$type": "color", "$description": "Texto branco absoluto em alto contraste" },
      "link": { "$value": "#FFFF00", "$type": "color", "$description": "Amarelo puro para links e foco (WCAG AAA)" },
      "border": { "$value": "#FFFFFF", "$type": "color", "$description": "Borda branca nítida em alto contraste" }
    }
  },
  "typography": {
    "fontFamily": {
      "ubuntu": {
        "$value": "'Ubuntu', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Tipografia oficial de interface e títulos"
      },
      "cormorant": {
        "$value": "'Cormorant Garamond', serif",
        "$type": "fontFamily",
        "$description": "Tipografia de elegância institucional e citações"
      },
      "istok": {
        "$value": "'Istok Web', sans-serif",
        "$type": "fontFamily",
        "$description": "Tipografia complementar web"
      }
    },
    "fontWeight": {
      "light": { "$value": 300, "$type": "fontWeight" },
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "fontSize": {
      "50": { "$value": "0.75rem", "$type": "dimension", "$description": "12px fixo - Legendas mínimas" },
      "75": { "$value": "clamp(0.75rem, 0.675rem + 0.38vw, 0.875rem)", "$type": "dimension", "$description": "12px a 14px - Textos secundários" },
      "100": { "$value": "clamp(0.875rem, 0.8rem + 0.38vw, 1rem)", "$type": "dimension", "$description": "14px a 16px - Corpo de texto padrão (p)" },
      "200": { "$value": "clamp(1rem, 0.925rem + 0.38vw, 1.125rem)", "$type": "dimension", "$description": "16px a 18px - Subtítulos menores (h6)" },
      "300": { "$value": "clamp(1.125rem, 1.05rem + 0.38vw, 1.25rem)", "$type": "dimension", "$description": "18px a 20px - Subtítulos (h5)" },
      "400": { "$value": "clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem)", "$type": "dimension", "$description": "20px a 24px - Títulos de seção (h4)" },
      "500": { "$value": "clamp(1.4rem, 1.19rem + 1.05vw, 1.75rem)", "$type": "dimension", "$description": "22.4px a 28px - Títulos de bloco (h3)" },
      "600": { "$value": "clamp(1.6rem, 1.36rem + 1.2vw, 2rem)", "$type": "dimension", "$description": "25.6px a 32px - Títulos de página (h2)" },
      "700": { "$value": "clamp(1.8rem, 1.53rem + 1.35vw, 2.25rem)", "$type": "dimension", "$description": "28.8px a 36px - Título principal (h1)" },
      "800": { "$value": "clamp(2.2rem, 1.72rem + 2.4vw, 3rem)", "$type": "dimension", "$description": "35.2px a 48px - Hero / Banners" }
    }
  },
  "spacing": {
    "0": { "$value": "0", "$type": "dimension", "$description": "0px" },
    "1": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
    "2": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
    "3": { "$value": "0.75rem", "$type": "dimension", "$description": "12px" },
    "4": { "$value": "1rem", "$type": "dimension", "$description": "16px - Espaçamento base padrão" },
    "5": { "$value": "1.25rem", "$type": "dimension", "$description": "20px" },
    "6": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
    "8": { "$value": "2rem", "$type": "dimension", "$description": "32px - Separação de blocos" },
    "12": { "$value": "3rem", "$type": "dimension", "$description": "48px" },
    "16": { "$value": "4rem", "$type": "dimension", "$description": "64px - Separação de grandes seções" },
    "24": { "$value": "6rem", "$type": "dimension", "$description": "96px" }
  },
  "borderRadius": {
    "0": { "$value": "0", "$type": "dimension", "$description": "Cantos retos / Alto contraste" },
    "4": { "$value": "0.25rem", "$type": "dimension", "$description": "4px - Campos e botões sutis" },
    "8": { "$value": "0.5rem", "$type": "dimension", "$description": "8px - Cards, modais e containers" },
    "pill": { "$value": "9999px", "$type": "dimension", "$description": "Badges, chips e tags arredondadas" }
  },
  "boxShadow": {
    "100": {
      "$value": "0 1px 2px rgba(0,0,0,0.06), 0 1px 1px rgba(0,0,0,0.04)",
      "$type": "boxShadow",
      "$description": "Sombra sutil de repouso (nível 1)"
    },
    "300": {
      "$value": "0 2px 4px rgba(0,0,0,0.10), 0 3px 3px rgba(0,0,0,0.08)",
      "$type": "boxShadow",
      "$description": "Sombra moderada de hover em cards e alertas (nível 2)"
    },
    "600": {
      "$value": "3px 3px 10px 0 hsla(0,0%,76%,0.5)",
      "$type": "boxShadow",
      "$description": "Sombra destacada de modais e floating elements (nível 3)"
    }
  }
}
