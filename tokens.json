{
  "$schema": "https://design-tokens.github.io/community-group/format/draft-v1.json",
  "name": "BCB Design Tokens",
  "version": "2.0.0",
  "description": "Design Tokens oficiais do Banco Central do Brasil alinhados ao Manual de Marca para consumo programático por IA, Figma Tokens e sistemas de build.",
  "color": {
    "base": {
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Fundo base padrão (modo claro)"
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Preto puro absoluto"
      },
      "bodyText": {
        "$value": "#606060",
        "$type": "color",
        "$description": "Cor de texto padrão do corpo de página (extraído de produção)"
      },
      "bgLight": {
        "$value": "#E0EBEE",
        "$type": "color",
        "$description": "Fundo suave alternativo (.bg-color-12)"
      }
    },
    "brand": {
      "azul-blue": {
        "$value": "#025C75",
        "$type": "color",
        "$description": "Azul institucional primário oficial (Pantone 3025 C)"
      },
      "azulcinti": {
        "$value": "#077391",
        "$type": "color",
        "$description": "Azul cinti complementar oficial (Pantone 7698 C)"
      },
      "azulpetro": {
        "$value": "#2E4C59",
        "$type": "color",
        "$description": "Azul petróleo complementar oficial (Pantone 7546 C)"
      },
      "azulnetuno": {
        "$value": "#476F82",
        "$type": "color",
        "$description": "Azul netuno complementar oficial (Pantone 7544 C)"
      },
      "verde-susta": {
        "$value": "#067078",
        "$type": "color",
        "$description": "Verde sustentabilidade complementar oficial (Pantone 7719 C)"
      },
      "verde-castell": {
        "$value": "#088694",
        "$type": "color",
        "$description": "Verde castell complementar oficial (Pantone 3145 C)"
      },
      "cinza-80": {
        "$value": "#606062",
        "$type": "color",
        "$description": "Cinza institucional 80% oficial (Pantone Cool Gray 10 C)"
      },
      "amarellato-biscoito": {
        "$value": "#F8D48D",
        "$type": "color",
        "$description": "Amarellato biscoito complementar oficial (Pantone 141 C)"
      },
      "cafellato": {
        "$value": "#DEBE7F",
        "$type": "color",
        "$description": "Cafellato institucional complementar oficial (Pantone 7508 C)"
      },
      "vinho-autentico": {
        "$value": "#47373A",
        "$type": "color",
        "$description": "Vinho autêntico institucional oficial (Pantone 4975 C)"
      },
      "marsala-suave": {
        "$value": "#736063",
        "$type": "color",
        "$description": "Marsala suave complementar oficial (Pantone 5005 C)"
      }
    },
    "action": {
      "primary": {
        "default": {
          "$value": "{color.brand.azul-blue}",
          "$type": "color",
          "$description": "Fundo padrão do botão primário"
        },
        "hover": {
          "$value": "{color.brand.azulcinti}",
          "$type": "color",
          "$description": "Fundo do botão primário em hover"
        },
        "active": {
          "$value": "{color.brand.azulpetro}",
          "$type": "color",
          "$description": "Fundo do botão primário em active/focus"
        }
      },
      "secondary": {
        "default": {
          "$value": "{color.brand.verde-castell}",
          "$type": "color",
          "$description": "Fundo padrão do botão secundário"
        },
        "hover": {
          "$value": "{color.brand.verde-susta}",
          "$type": "color",
          "$description": "Fundo do botão secundário em hover"
        },
        "active": {
          "$value": "{color.brand.azulpetro}",
          "$type": "color",
          "$description": "Fundo do botão secundário em active/focus"
        }
      },
      "link": {
        "default": {
          "$value": "#1B75A6",
          "$type": "color",
          "$description": "Cor padrão de links e âncoras"
        },
        "hover": {
          "$value": "{color.brand.azul-blue}",
          "$type": "color",
          "$description": "Cor de links em hover"
        }
      }
    },
    "feedback": {
      "success": {
        "$value": "{color.brand.verde-susta}",
        "$type": "color",
        "$description": "Verde semântico de sucesso oficial"
      },
      "warningSurface": {
        "$value": "{color.brand.amarellato-biscoito}",
        "$type": "color",
        "$description": "Superfície de alerta/atenção oficial"
      },
      "warningBorder": {
        "$value": "{color.brand.cafellato}",
        "$type": "color",
        "$description": "Borda de alerta/atenção oficial"
      },
      "danger": {
        "$value": "{color.brand.vinho-autentico}",
        "$type": "color",
        "$description": "Cor semântica de erro/perigo oficial"
      },
      "info": {
        "$value": "{color.brand.azul-blue}",
        "$type": "color",
        "$description": "Azul semântico informativo oficial"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.base.bodyText}",
        "$type": "color",
        "$description": "Cor principal do corpo de texto"
      },
      "secondary": {
        "$value": "{color.brand.cinza-80}",
        "$type": "color",
        "$description": "Texto secundário / apoio institucional"
      }
    },
    "surface": {
      "light": {
        "$value": "{color.base.bgLight}",
        "$type": "color",
        "$description": "Superfície clara de apoio"
      },
      "card": {
        "$value": "{color.gray.100}",
        "$type": "color",
        "$description": "Fundo padrão de cartões e painéis"
      }
    },
    "gray": {
      "50": { "$value": "#FAFBFC", "$type": "color", "$description": "Cinza UI 50 - Fundo de áreas secundárias" },
      "100": { "$value": "#F3F5F7", "$type": "color", "$description": "Cinza UI 100 - Fundo de cards e caixas de busca" },
      "200": { "$value": "#E6EAEF", "$type": "color", "$description": "Cinza UI 200 - Bordas sutis e divisores" },
      "300": { "$value": "#D0D7DF", "$type": "color", "$description": "Cinza UI 300 - Bordas padrão de inputs e tabelas" },
      "400": { "$value": "#B7C0CB", "$type": "color", "$description": "Cinza UI 400 - Bordas em destaque e desabilitados" },
      "500": { "$value": "#9AA6B2", "$type": "color", "$description": "Cinza UI 500 - Textos de apoio e ícones secundários" },
      "600": { "$value": "#7E8A95", "$type": "color", "$description": "Cinza UI 600 - Textos muted e legendas" },
      "700": { "$value": "#606062", "$type": "color", "$description": "Cinza UI 700 - Texto escuro institucional" },
      "800": { "$value": "#3E454B", "$type": "color", "$description": "Cinza UI 800 - Títulos secundários" },
      "900": { "$value": "#22272B", "$type": "color", "$description": "Cinza UI 900 - Títulos principais e elementos escuros" },
      "1000": { "$value": "#0B0D0E", "$type": "color", "$description": "Cinza UI 1000 - Preto profundo de interface" }
    },
    "tint": {
      "brandLight": { "$value": "#F0F7F9", "$type": "color", "$description": "Tint suave para callout brand" },
      "verdeLight": { "$value": "#F0F8F8", "$type": "color", "$description": "Tint suave para callout success" },
      "amarellatoLight": { "$value": "#FEFBFA", "$type": "color", "$description": "Tint suave para callout warning" },
      "vinhoLight": { "$value": "#F5F7F8", "$type": "color", "$description": "Tint suave para callout danger" },
      "grayLight": { "$value": "#F8F9FB", "$type": "color", "$description": "Tint suave para callout neutral" }
    },
    "highContrast": {
      "bgLevel1": { "$value": "#000000", "$type": "color", "$description": "Fundo absoluto em alto contraste" },
      "bgLevel2": { "$value": "#222222", "$type": "color", "$description": "Fundo de cartões em alto contraste" },
      "bgLevel3": { "$value": "#333333", "$type": "color", "$description": "Fundo de botões e controles" },
      "text": { "$value": "#FFFFFF", "$type": "color", "$description": "Texto branco absoluto em alto contraste" },
      "link": { "$value": "#FFFF00", "$type": "color", "$description": "Amarelo puro para links e foco (WCAG AAA)" },
      "border": { "$value": "#FFFFFF", "$type": "color", "$description": "Borda branca nítida em alto contraste" }
    },
    "chart": {
      "series-01": { "$value": "#2E4C59", "$type": "color", "$description": "1ª Cor (Azul): RGB 46,76,89" },
      "series-02": { "$value": "#F2B557", "$type": "color", "$description": "2ª Cor (Amarelo): RGB 242,181,87" },
      "series-03": { "$value": "#6BAEBF", "$type": "color", "$description": "3ª Cor (Ciano): RGB 107,174,191" },
      "series-04": { "$value": "#804C29", "$type": "color", "$description": "4ª Cor (Marrom): RGB 128,76,41" },
      "series-05": { "$value": "#87007C", "$type": "color", "$description": "5ª Cor (Púrpura): RGB 135,0,124" },
      "series-06": { "$value": "#D46C6B", "$type": "color", "$description": "6ª Cor (Coral): RGB 212,108,107" },
      "series-07": { "$value": "#088492", "$type": "color", "$description": "7ª Cor (Verde-Azul): RGB 8,132,146" },
      "series-08": { "$value": "#D295BE", "$type": "color", "$description": "8ª Cor (Rosa): RGB 210,149,190" },
      "series-09": { "$value": "#ECCAB1", "$type": "color", "$description": "9ª Cor (Pêssego): RGB 236,202,177" },
      "series-10": { "$value": "#AEAEAE", "$type": "color", "$description": "10ª Cor (Cinza): RGB 174,174,174" },
      "series-11": { "$value": "#736063", "$type": "color", "$description": "11ª Cor (Castanho): RGB 115,96,99" },
      "series-12": { "$value": "#C3A061", "$type": "color", "$description": "12ª Cor (Ocre): RGB 195,160,97" },
      "gridline": { "$value": "rgba(96, 96, 96, 0.5)", "$type": "color", "$description": "Gridlines: #606060 com 50% de opacidade" }
    },
    "table": {
      "text": { "$value": "#606060", "$type": "color", "$description": "Tipografia e linhas padrão de tabelas analíticas" },
      "border": { "$value": "#606060", "$type": "color", "$description": "Bordas estruturais de tabelas analíticas" },
      "col-separator": { "$value": "#dcdcdc", "$type": "color", "$description": "Separador vertical de colunas finas (0.5pt)" },
      "header-bg": { "$value": "#2E4C59", "$type": "color", "$description": "Fundo de cabeçalhos digitais" },
      "header-text": { "$value": "#FFFFFF", "$type": "color", "$description": "Texto de cabeçalhos digitais" },
      "zebra": { "$value": "rgba(46, 76, 89, 0.04)", "$type": "color", "$description": "Zebrado digital em linhas alternadas (4% opacidade)" },
      "highlight-bg": { "$value": "rgba(242, 181, 87, 0.15)", "$type": "color", "$description": "Realce suave de linha ou total (15% amarelo)" },
      "highlight-text": { "$value": "#4a3107", "$type": "color", "$description": "Texto sobre realce suave" },
      "num-negative": { "$value": "#B30000", "$type": "color", "$description": "Números negativos em alto contraste (WCAG)" },
      "total-text": { "$value": "#2E4C59", "$type": "color", "$description": "Texto em negrito para totais em variantes estritas" }
    }
  },
  "typography": {
    "fontFamily": {
      "ubuntu": {
        "$value": "'Ubuntu', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Tipografia oficial de interface e títulos"
      },
      "cormorant": {
        "$value": "'Cormorant Garamond', serif",
        "$type": "fontFamily",
        "$description": "Tipografia de elegância institucional e citações"
      },
      "istok": {
        "$value": "'Istok Web', sans-serif",
        "$type": "fontFamily",
        "$description": "Tipografia complementar web"
      }
    },
    "fontWeight": {
      "light": { "$value": 300, "$type": "fontWeight" },
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "fontSize": {
      "50": { "$value": "0.75rem", "$type": "dimension", "$description": "12px fixo - Legendas mínimas" },
      "75": { "$value": "clamp(0.75rem, 0.675rem + 0.38vw, 0.875rem)", "$type": "dimension", "$description": "12px a 14px - Textos secundários" },
      "100": { "$value": "clamp(0.875rem, 0.8rem + 0.38vw, 1rem)", "$type": "dimension", "$description": "14px a 16px - Corpo de texto padrão (p)" },
      "200": { "$value": "clamp(1rem, 0.925rem + 0.38vw, 1.125rem)", "$type": "dimension", "$description": "16px a 18px - Subtítulos menores (h6)" },
      "300": { "$value": "clamp(1.125rem, 1.05rem + 0.38vw, 1.25rem)", "$type": "dimension", "$description": "18px a 20px - Subtítulos (h5)" },
      "400": { "$value": "clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem)", "$type": "dimension", "$description": "20px a 24px - Títulos de seção (h4)" },
      "500": { "$value": "clamp(1.4rem, 1.19rem + 1.05vw, 1.75rem)", "$type": "dimension", "$description": "22.4px a 28px - Títulos de bloco (h3)" },
      "600": { "$value": "clamp(1.6rem, 1.36rem + 1.2vw, 2rem)", "$type": "dimension", "$description": "25.6px a 32px - Títulos de página (h2)" },
      "700": { "$value": "clamp(1.8rem, 1.53rem + 1.35vw, 2.25rem)", "$type": "dimension", "$description": "28.8px a 36px - Título principal (h1)" },
      "800": { "$value": "clamp(2.2rem, 1.72rem + 2.4vw, 3rem)", "$type": "dimension", "$description": "35.2px a 48px - Hero / Banners" }
    }
  },
  "spacing": {
    "0": { "$value": "0", "$type": "dimension", "$description": "0px" },
    "1": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
    "2": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
    "3": { "$value": "0.75rem", "$type": "dimension", "$description": "12px" },
    "4": { "$value": "1rem", "$type": "dimension", "$description": "16px - Espaçamento base padrão" },
    "5": { "$value": "1.25rem", "$type": "dimension", "$description": "20px" },
    "6": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
    "8": { "$value": "2rem", "$type": "dimension", "$description": "32px - Separação de blocos" },
    "12": { "$value": "3rem", "$type": "dimension", "$description": "48px" },
    "16": { "$value": "4rem", "$type": "dimension", "$description": "64px - Separação de grandes seções" },
    "24": { "$value": "6rem", "$type": "dimension", "$description": "96px" }
  },
  "borderRadius": {
    "0": { "$value": "0", "$type": "dimension", "$description": "Cantos retos / Alto contraste" },
    "4": { "$value": "0.25rem", "$type": "dimension", "$description": "4px - Campos e botões sutis" },
    "8": { "$value": "0.5rem", "$type": "dimension", "$description": "8px - Cards, modais e containers" },
    "pill": { "$value": "9999px", "$type": "dimension", "$description": "Badges, chips e tags arredondadas" }
  },
  "boxShadow": {
    "100": {
      "$value": "0 1px 2px rgba(0,0,0,0.06), 0 1px 1px rgba(0,0,0,0.04)",
      "$type": "boxShadow",
      "$description": "Sombra sutil de repouso (nível 1)"
    },
    "300": {
      "$value": "0 2px 4px rgba(0,0,0,0.10), 0 3px 3px rgba(0,0,0,0.08)",
      "$type": "boxShadow",
      "$description": "Sombra moderada de hover em cards e alertas (nível 2)"
    },
    "600": {
      "$value": "3px 3px 10px 0 hsla(0,0%,76%,0.5)",
      "$type": "boxShadow",
      "$description": "Sombra destacada de modais e floating elements (nível 3)"
    }
  },
  "zIndex": {
    "deep": { "$value": "-1", "$type": "dimension", "$description": "Camada subjacente/decorativa (-1)" },
    "base": { "$value": "1", "$type": "dimension", "$description": "Elementos internos, conectores de linha e steps (1)" },
    "elevated": { "$value": "2", "$type": "dimension", "$description": "Badges sobrepostos, ícones ativos e headers (2)" },
    "dropdown": { "$value": "100", "$type": "dimension", "$description": "Sidebar aderente, dropdowns e navegação fixa (100)" },
    "sticky": { "$value": "999", "$type": "dimension", "$description": "Botão flutuante Voltar ao Topo (999)" },
    "overlay": { "$value": "1050", "$type": "dimension", "$description": "Navbar de topo, backdrop e modais (1050)" },
    "toast": { "$value": "1060", "$type": "dimension", "$description": "Notificações, toasts e alerts flutuantes (1060)" },
    "max": { "$value": "99999", "$type": "dimension", "$description": "Skip links de acessibilidade ativados via teclado (99999)" }
  }
}
